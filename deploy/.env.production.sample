# Baton production environment for one VPS.
#
#   cp deploy/.env.production.sample deploy/.env.production
#   chmod 600 deploy/.env.production      # root-only: it holds every secret
#   # edit the values marked CHANGE_ME, then:
#   docker compose -f deploy/compose.prod.yml --env-file deploy/.env.production up -d
#
# Syntax: KEY=value, no spaces around `=`, no quotes. Compose reads this file
# for interpolation only; it is never baked into an image or passed by name.
# deploy/.env.production is gitignored. Everything marked CHANGE_ME must change
# before the stack serves real people; the stack starts with the placeholders,
# so check them (`grep CHANGE_ME deploy/.env.production`) before going live.

# ---------------------------------------------------------------------------
# Public address and TLS
# ---------------------------------------------------------------------------

# Hostname Caddy serves and gets a certificate for. Must already point at this
# VPS (A record and, if you use it, AAAA). No scheme, no path.
BATON_DOMAIN=tracker.example.com

# Contact address for Let's Encrypt expiry notices. Optional but recommended.
BATON_ACME_EMAIL=admin@example.com

# Same-origin deployment: the bundled container serves the web app and the API.
# Use https and the public domain, exactly as people will type it.
BATON_CLIENT_URL=https://tracker.example.com
# Leave BATON_API_URL unset: the entrypoint derives ${BATON_CLIENT_URL}/api.
# BATON_API_URL=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

POSTGRES_DB=baton
POSTGRES_USER=baton
# CHANGE_ME: openssl rand -base64 24 (avoid characters that need URL escaping;
# this same value may end up inside DATABASE_URL below).
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# Leave DATABASE_URL unset for the bundled Postgres: the container derives it
# from POSTGRES_* with host `postgres`. Set it to move to managed Postgres and
# nothing else in the stack changes (also set POSTGRES_HOST if you keep
# deriving instead). Example:
# DATABASE_URL=postgresql://baton:password@db.example.com:25060/baton?sslmode=require
# DATABASE_URL=

# Connections per API process. One API instance: 10 is plenty.
# DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Authentication and access policy
# ---------------------------------------------------------------------------

# CHANGE_ME: openssl rand -base64 32
# Protects every login session. Set it once and never change it: a new value
# signs everyone out. Do not reuse a value from another environment. The API
# refuses to start with fewer than 32 characters, so an unchanged placeholder
# fails loudly instead of running with a weak secret.
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32

# CHANGE_ME: openssl rand -base64 32
# Encrypts webhook signing secrets and notification tokens. Required to create
# webhooks; changing it makes previously stored secrets unreadable.
NOTIFICATION_SECRET_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32

# Invite-only: after the first account and workspace exist, set this to true so
# only people you invited can create an account. Invitations keep working
# because a valid pending invitation is the exception. "false" (or unset)
# leaves open signup on, which is wrong for a paid public instance.
DISABLE_REGISTRATION=false
# Optional locks. DISABLE_WORKSPACE_CREATION=true restricts new workspaces to
# instance admins. DISABLE_PASSWORD_REGISTRATION=true turns off password
# signup while leaving invited signup usable.
# DISABLE_WORKSPACE_CREATION=false
# DISABLE_PASSWORD_REGISTRATION=false

# Hosted multi-tenant instance: tightens rate limits and rejects disposable
# email domains at signup. Leave true unless this is a private self-host.
BATON_CLOUD=true

# Let webhooks target private/loopback addresses. Leave unset (deny) on a host
# that can reach your internal network.
# BATON_ALLOW_PRIVATE_WEBHOOK_DESTINATIONS=false

# ---------------------------------------------------------------------------
# Email (optional). Without SMTP, invitation and reset emails are not sent;
# invitations still work from the link the inviter copies.
# ---------------------------------------------------------------------------

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=baton@example.com
# SMTP_PASSWORD=
# SMTP_FROM=Baton <baton@example.com>
# SMTP_REQUIRE_TLS=true

# ---------------------------------------------------------------------------
# GitHub (optional): linking an account for repo sync, and the GitHub App
# webhook. People still sign in with email and password.
# ---------------------------------------------------------------------------

# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_APP_ID=
# GITHUB_APP_NAME=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_PRIVATE_KEY_BASE64=        # base64 of the PEM: no newline problems in env

# ---------------------------------------------------------------------------
# Slack direct messages (optional). No token means nothing is sent.
# ---------------------------------------------------------------------------

# SLACK_BOT_TOKEN=xoxb-...
# SLACK_DIGEST_CRON=0 10 * * 1-5
# SLACK_DIGEST_TZ=Asia/Kolkata

# ---------------------------------------------------------------------------
# Uploads (optional). Without S3 the attachment feature is unavailable; the
# container filesystem is not a safe place for files.
# ---------------------------------------------------------------------------

# S3_ENDPOINT=https://files.example.com
# S3_BUCKET=baton-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# S3_MAX_IMAGE_UPLOAD_BYTES=10485760
# S3_PRESIGN_TTL_SECONDS=300
# S3_KEY_PREFIX=

# ---------------------------------------------------------------------------
# Error tracking (optional). Nothing is reported while SENTRY_DSN is empty.
# ---------------------------------------------------------------------------

# SENTRY_DSN=https://...ingest.sentry.io/...
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1
# SENTRY_RELEASE=

# ---------------------------------------------------------------------------
# Nightly backups: custom-format pg_dump to any S3-compatible bucket.
# Create a bucket and a key limited to it. Use a separate key from the uploads
# one above so a leaked uploads key cannot delete backups.
# ---------------------------------------------------------------------------

BACKUP_S3_BUCKET=baton-backups
# Leave unset for AWS S3; set for R2, Spaces, B2, MinIO, etc.
# BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
BACKUP_S3_REGION=us-east-1
# CHANGE_ME
BACKUP_S3_ACCESS_KEY_ID=CHANGE_ME_backup_access_key
# CHANGE_ME
BACKUP_S3_SECRET_ACCESS_KEY=CHANGE_ME_backup_secret_key

# Objects land under $BACKUP_PREFIX/<timestamp>.dump, newest kept in the
# bucket itself, older ones deleted by the backup container.
BACKUP_PREFIX=baton/postgres
BACKUP_RETENTION_DAYS=14

# Daily run time, UTC, HH:MM. The sidecar waits for this and repeats.
BACKUP_SCHEDULE_UTC=03:15

# ---------------------------------------------------------------------------
# Optional Redis (only for more than one API instance). Uncomment the redis
# service in deploy/compose.prod.yml, set REDIS_URL, and start with
# `--profile redis`. One API instance must leave this unset.
# ---------------------------------------------------------------------------

# REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------------------
# Probe addresses the API trusts as proxies. The default matches the compose
# network: nginx inside the app container, then Caddy on baton_net. Change it
# if you change that subnet or put another proxy in front.
# ---------------------------------------------------------------------------

# TRUSTED_PROXIES=127.0.0.0/8,172.28.0.0/24

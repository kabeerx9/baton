# LOCAL SMOKE TEST ONLY. Throwaway values, no real secrets, localhost domain.
# Used with deploy/compose.smoke.yml; see docs/deploy.md, "Local smoke test".
#
#   docker compose -p baton-deploy-smoke -f deploy/compose.prod.yml \
#     -f deploy/compose.smoke.yml --env-file deploy/.env.smoke.sample up -d --build

# Caddy uses its local CA for a dotless name, so TLS works without a domain.
BATON_DOMAIN=localhost
# Caddy parses `email` unconditionally, so this cannot be empty.
BATON_ACME_EMAIL=smoke@example.invalid
BATON_CLIENT_URL=https://localhost

POSTGRES_DB=baton
POSTGRES_USER=baton
POSTGRES_PASSWORD=smoke-postgres-password

AUTH_SECRET=smoke-only-auth-secret-0123456789
NOTIFICATION_SECRET_ENCRYPTION_KEY=smoke-only-notification-key-0123456789
DISABLE_REGISTRATION=false

# Local MinIO stands in for S3-compatible object storage.
MINIO_ROOT_USER=smoke-minio
MINIO_ROOT_PASSWORD=smoke-minio-password
BACKUP_S3_BUCKET=baton-backups
BACKUP_S3_ENDPOINT=http://minio:9000
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY_ID=smoke-minio
BACKUP_S3_SECRET_ACCESS_KEY=smoke-minio-password
BACKUP_RETENTION_DAYS=2

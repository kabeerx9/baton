# General URLs
BATON_CLIENT_URL=http://localhost:5173
# BATON_API_URL=http://localhost:1337      # set for host-native API; bundled image derives CLIENT_URL/api
# BATON_INTERNAL_API_URL=http://127.0.0.1:1337 # optional - internal MCP tool requests only
# BATON_API_PORT=1337                      # optional - host-native listen port; keep 1337 in the bundled image
# CORS_ORIGINS=                            # optional - comma-separated; defaults to BATON_CLIENT_URL

# Database
# DATABASE_URL=                            # optional: use this for host-native or external DB access
POSTGRES_DB=baton
POSTGRES_USER=baton
POSTGRES_PASSWORD=
# Alternatively, mount a secret file and set POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
# POSTGRES_HOST=postgres                   # Compose container default; use localhost for host-native API startup
# POSTGRES_PORT=5432
# DATABASE_POOL_MAX=10                     # max connections per API process (min 2); lower it if the DB user has a connection limit
# Note: POSTGRES_DB and POSTGRES_USER alone do not enable derived connection mode.
# Derived DATABASE_URL is only used when POSTGRES_PASSWORD or an explicit host/port is set.

# Redis Pub/Sub for WebSockets (Optional) -> auto fallback to in memory
# Only one mode should be configured. Priority: Cluster > Sentinel > Standalone.

# Standalone
#REDIS_URL=

# Sentinel
#REDIS_SENTINELS=
#REDIS_SENTINEL_MASTER_NAME=mymaster
#REDIS_SENTINEL_PASSWORD=
#REDIS_SENTINEL_TLS=false

# Cluster
#REDIS_CLUSTER_NODES=

# Shared (Sentinel & Cluster)
#REDIS_PASSWORD=

# Authentication
# Generate with: openssl rand -hex 32
# Required for host-native startup. Bundled image generates a temporary one if unset.
# Keep it stable: it protects authentication sessions.
AUTH_SECRET=
# Alternatively, mount a secret file and set AUTH_SECRET_FILE=/run/secrets/auth_secret

# GitHub OAuth App: used only to link a GitHub account for repo connection.
# People sign in with email and password; GitHub sign-in and sign-up are refused.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# GitHub integration (GitHub App: repository sync, webhooks)
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_APP_NAME=

# SMTP Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REQUIRE_TLS=
# Optional public base URL for email images. Defaults to BATON_CLIENT_URL/email.
#BATON_EMAIL_ASSETS_URL=

# Cloud-mode abuse mitigations (only enable on hosted multi-tenant instances).
# When BATON_CLOUD=true: signup with disposable-email providers is blocked
# and tighter rate limits apply.
#BATON_CLOUD=false

# Sentry error tracking (Optional): errors are only reported when a DSN is set
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1         # 0.0 disables; default 0 (opt-in)
# SENTRY_PROFILES_SAMPLE_RATE=0.1      # 0.0 disables; default 0 (opt-in)
# SENTRY_RELEASE=                       # git SHA; the image sets it from CI. Falls back to package.json version.
# BATON_SENTRY_DSN=                     # bundled image only: browser DSN (https), rendered into web assets at startup
# BATON_SENTRY_ENVIRONMENT=production   # bundled image only: browser environment name
# Local Vite dev reads VITE_SENTRY_DSN / VITE_SENTRY_ENVIRONMENT from apps/web/.env.local instead.

# Logs: one JSON line per entry on stdout (readable text when NODE_ENV is not production)
# LOG_LEVEL=info                        # debug | info | warn | error; default info in production, debug otherwise
# SENTRY_API_TOKEN=                     # Used by scripts/provision-sentry-alerts.sh and scripts/provision-sentry-dashboards.sh. Scope: org:write. https://sentry.io/settings/account/api/auth-tokens/

# Private uploads: Silo or another S3-compatible provider (Optional)
# S3_ENDPOINT=https://files.example.com    # reachable by the API and browser
# S3_BUCKET=baton
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# S3_MAX_IMAGE_UPLOAD_BYTES=10485760
# S3_PRESIGN_TTL_SECONDS=300
# S3_KEY_PREFIX=

# Access policy (Optional)
# DISABLE_REGISTRATION=false
# DISABLE_PASSWORD_REGISTRATION=false
# DISABLE_WORKSPACE_CREATION=false
# BATON_ALLOW_PRIVATE_WEBHOOK_DESTINATIONS=false

# Required when saving personal notification tokens or signing secrets. Keep stable.
# NOTIFICATION_SECRET_ENCRYPTION_KEY=

# Slack direct messages (optional). With no token, nothing is sent.
# Create a Slack app with the bot scopes `chat:write` and `users:read.email`,
# install it to the workspace, and paste its Bot User OAuth Token here.
# People are matched to Slack by the email of their tracker account.
SLACK_BOT_TOKEN=
# When the "Waiting on you" digest goes out: this local time (24-hour HH:MM),
# Monday to Friday, in each person's own time zone. Default: 10:00.
SLACK_DIGEST_TIME=10:00
# The time zone for people who have not set one. Default: Asia/Kolkata.
SLACK_DIGEST_TZ=Asia/Kolkata
